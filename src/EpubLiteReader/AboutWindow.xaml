<Window x:Class="EpubLiteReader.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EpubLiteReader"
        Width="600" Height="640"
        MinWidth="480" MinHeight="460"
        Background="#FF2B2B2B"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AboutFg" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="AboutFgDim" Color="#FFAAAAAA"/>

        <Style TargetType="Button" x:Key="AboutButton">
            <Setter Property="Background" Value="#FF3D3D3D"/>
            <Setter Property="Foreground" Value="{StaticResource AboutFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1F5B94"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="bd" Property="Background" Value="#FF505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="AboutPrimaryButton" BasedOn="{StaticResource AboutButton}">
            <Setter Property="Background" Value="#FF1F5B94"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#FF6FA8DC"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF9CC7EE"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <!-- ===================== About view ===================== -->
        <DockPanel x:Name="AboutView">
            <Border DockPanel.Dock="Bottom" Padding="20,12" Background="#FF242424">
                <DockPanel LastChildFill="False">
                    <Button x:Name="ContactSupportButton" DockPanel.Dock="Left"
                            Style="{StaticResource AboutPrimaryButton}"
                            Content="{local:Loc AboutContactSupport}"
                            Click="ContactSupport_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AboutButton}" Margin="0"
                            Content="{local:Loc AboutClose}" IsCancel="True"/>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Image x:Name="AppMark" Width="64" Height="64" VerticalAlignment="Top"
                               SnapsToDevicePixels="True"/>
                        <StackPanel Margin="16,2,0,0">
                            <TextBlock Text="{local:Loc AppTitle}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource AboutFg}"/>
                            <TextBlock x:Name="VersionText" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{StaticResource AboutFgDim}"/>
                            <TextBlock Text="{local:Loc AboutPublishedBy}" FontSize="13" Margin="0,2,0,0"
                                       Foreground="{StaticResource AboutFgDim}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{local:Loc AboutBrandBlurb}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource AboutFg}" Margin="0,0,0,12" LineHeight="20"/>

                    <TextBlock x:Name="CopyrightText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource AboutFgDim}" Margin="0,0,0,14"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="13" Margin="0,0,0,6">
                            <Hyperlink NavigateUri="https://greenyogainc.com/" RequestNavigate="Link_RequestNavigate"
                                       ToolTip="https://greenyogainc.com/">
                                <Run Text="{local:Loc AboutWebsiteLink}"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,0,0,6">
                            <Hyperlink NavigateUri="https://greenyogainc.com/privacy/" RequestNavigate="Link_RequestNavigate"
                                       ToolTip="https://greenyogainc.com/privacy/">
                                <Run Text="{local:Loc AboutPrivacyLink}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <Expander Foreground="{StaticResource AboutFg}" FontSize="13"
                              Header="{local:Loc AboutLicenseLink}">
                        <TextBox x:Name="LicenseText" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="#FF1E1E1E" Foreground="{StaticResource AboutFgDim}"
                                 BorderBrush="#FF4A4A4A" FontSize="11" Margin="0,8,0,0"
                                 MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{local:Loc AboutLicenseLink}"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ===================== Support view ===================== -->
        <DockPanel x:Name="SupportView" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Padding="12,10" Background="#FF242424">
                <DockPanel LastChildFill="False">
                    <Button x:Name="SupportBackButton" DockPanel.Dock="Left"
                            Style="{StaticResource AboutButton}"
                            Content="{local:Loc SupportBack}" Click="SupportBack_Click"/>
                    <TextBlock DockPanel.Dock="Left" Text="{local:Loc AboutContactSupport}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="{StaticResource AboutFg}"/>
                </DockPanel>
            </Border>

            <Grid>
                <!-- Disclosure before anything loads: internet + third-party privacy policy. -->
                <StackPanel x:Name="SupportDisclosurePanel" Margin="24,20" VerticalAlignment="Center"
                            MaxWidth="520">
                    <TextBlock Text="{local:Loc SupportDisclosure}" TextWrapping="Wrap" FontSize="13"
                               LineHeight="20" Foreground="{StaticResource AboutFg}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SupportLoadButton" Style="{StaticResource AboutPrimaryButton}"
                                Content="{local:Loc SupportLoadButton}" Click="SupportLoad_Click"/>
                        <Button Style="{StaticResource AboutButton}"
                                Content="{local:Loc SupportOpenInBrowser}" Click="SupportOpenBrowser_Click"/>
                        <Button Style="{StaticResource AboutButton}"
                                Content="{local:Loc SupportEmail}" Click="SupportEmail_Click"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="SupportLoadingText" Text="{local:Loc SupportLoading}"
                           Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource AboutFgDim}"/>

                <!-- Offline / load failure fallback. -->
                <StackPanel x:Name="SupportFailurePanel" Margin="24,20" VerticalAlignment="Center"
                            MaxWidth="520" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc SupportLoadFailed}" TextWrapping="Wrap" FontSize="13"
                               LineHeight="20" Foreground="{StaticResource AboutFg}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AboutPrimaryButton}"
                                Content="{local:Loc SupportRetry}" Click="SupportRetry_Click"/>
                        <Button Style="{StaticResource AboutButton}"
                                Content="{local:Loc SupportOpenInBrowser}" Click="SupportOpenBrowser_Click"/>
                        <Button Style="{StaticResource AboutButton}"
                                Content="{local:Loc SupportEmail}" Click="SupportEmail_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- The dedicated support WebView2 is created in code, only after the
                     user explicitly chooses to load the remote page. -->
                <Border x:Name="SupportWebHost" Visibility="Collapsed" Background="White"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
