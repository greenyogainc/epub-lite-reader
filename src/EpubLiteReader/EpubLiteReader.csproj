<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>EpubLiteReader</AssemblyName>
    <RootNamespace>EpubLiteReader</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Green Yoga Inc</Authors>
    <Company>Green Yoga Inc</Company>
    <Product>EPUB Lite Reader</Product>
    <Description>A free, lightweight EPUB reader for Windows.</Description>
    <Copyright>Copyright © 2026 Green Yoga Inc — released as freeware (MIT License)</Copyright>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>es;fr;de;it;pt;pt-BR;ja;ko;zh-Hans;zh-Hant;ru;uk;ar</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
