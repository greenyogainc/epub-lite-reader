## Ignore
bin/
obj/
dist/
packaging/out/
# Built MSIX packages are release artifacts, not source — they ship on the
# GitHub release / Store, never in the tree. The rest of the submission pack
# (evidence, listing, checksums, screenshots) is tracked.
packaging/submission-*/packages/
*.user
*.suo
.vs/
.idea/
__pycache__/
*.log
*.epub
!tools/fixtures/*.epub
!packaging/store-screenshots/source/*.epub
!src/EpubLiteReader/Assets/*.epub

# VarAlign local store (machine-local variable-tracking data)
.varmem/*
